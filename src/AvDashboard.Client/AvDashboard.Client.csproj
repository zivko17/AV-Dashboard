<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>AvDashboard.Client</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    net8.0 a secas y no net8.0-windows: aqui no hay nada de Windows. Es lo que permite que
    lo compilen y prueben las dos interfaces —la de WPF y la de WinUI 3— y ademas que el CI
    de Linux lo cubra, que es donde se prueba de verdad.
  -->

  <ItemGroup>
    <ProjectReference Include="..\AvDashboard.Core\AvDashboard.Core.csproj" />
  </ItemGroup>

  <!--
    Las pruebas ven lo interno. Se usa para lo que decide y no se ensena: el orden de los
    medidores de una tarjeta, por ejemplo, que no tiene por que ser publico para que las dos
    interfaces funcionen pero si tiene que estar probado, porque ya se rompio una vez.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AvDashboard.Client.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.0" />
  </ItemGroup>

</Project>
