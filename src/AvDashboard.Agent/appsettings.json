{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "Port": 47821,
    "BindLoopback": true,
    "BindTailscale": true,
    "PortableMode": false,
    "Telemetry": {
      "SystemIntervalMs": 1000,
      "AudioMeterIntervalMs": 50,
      "ServiceIntervalMs": 15000,
      "NetworkIntervalMs": 1000,
      "PingIntervalMs": 1000,
      "PingTimeoutMs": 800
    },
    "Retention": {
      "RawSampleDays": 7,
      "EventDays": 90
    },
    // Reliquia: ya no configura nada. Los equipos vigilados viven en la tabla `devices` de
    // la base y se gestionan desde la pestaña Red o por /api/v1/network/devices. Lo que
    // quede aquí se migra a la base en el primer arranque y después se ignora.
    // Ver docs/adr/0008-los-dispositivos-criticos-viven-en-la-base.md
    "CriticalDevices": []
  }
}
