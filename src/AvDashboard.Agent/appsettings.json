{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Agent": {
    "Port": 47821,
    "BindLoopback": true,
    "BindTailscale": true,
    "NodeName": null,
    "PortableMode": false,
    "Telemetry": {
      "SystemIntervalMs": 1000,
      "AudioMeterIntervalMs": 50,
      "ServiceIntervalMs": 15000,
      "NetworkIntervalMs": 1000,
      "PingIntervalMs": 1000,
      "PingTimeoutMs": 800
    },
    "Retention": {
      "RawSampleDays": 7,
      "EventDays": 90
    },
    "CriticalDevices": []
  }
}
