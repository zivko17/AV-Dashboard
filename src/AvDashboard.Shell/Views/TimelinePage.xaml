<UserControl
    x:Class="AvDashboard.Shell.Views.TimelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvDashboard.Shell">

    <UserControl.Resources>
        <local:SeverityBrushConverter x:Key="SeverityBrush" />
        <local:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="BoolNot" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="8" Padding="0,8,0,24">

            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="Todos los módulos correlados por timestamp. Es lo que permite reconstruir qué pasó en lugar de discutirlo." />

            <InfoBar
                IsOpen="{Binding Error, Converter={StaticResource StringNotEmpty}, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{Binding Error}" />

            <!--
                La ventana es un desplegable con las cuatro que se piden de verdad, y no un
                cuadro de texto: escribir un número a mano delante del cliente es una
                operación más de las que hacen falta. Además evita el ida y vuelta entre
                int y double que impone el NumberBox de WinUI.
            -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,4">
                <TextBlock Text="Ventana (min)" VerticalAlignment="Center"
                           Style="{StaticResource BodyTextBlockStyle}" />
                <ComboBox
                    MinWidth="110"
                    ItemsSource="{Binding WindowOptions}"
                    SelectedItem="{Binding WindowMinutes, Mode=TwoWay}" />
                <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
                <TextBlock Text="{Binding Summary}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />

                            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                       Style="{StaticResource MonoTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding Module}"
                                       Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding SectorText}"
                                       Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{Binding Kind}"
                                       Style="{StaticResource MonoTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="5" Text="{Binding Message}" TextWrapping="Wrap" />

                            <!--
                              Solo en las lineas que cambiaron un ajuste. Quien decide de
                              verdad si se puede es el agente: aqui solo se evita ofrecerlo
                              en una linea de ping, que no tiene nada que deshacer.
                            -->
                            <Button Grid.Column="6" Content="Deshacer"
                                    Background="Transparent" BorderThickness="0" Padding="8,2"
                                    VerticalAlignment="Center"
                                    Command="{Binding UndoCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                    ToolTipService.ToolTip="Devolver este ajuste al valor que tenía antes de este cambio"
                                    Visibility="{Binding CanAttemptUndo, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Margin="0,8,0,0"
                Visibility="{Binding Events.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}"
                Text="Ningún evento en esta ventana. Si esperabas alguno, amplíala: el agente solo registra lo que ha visto desde que arrancó." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
