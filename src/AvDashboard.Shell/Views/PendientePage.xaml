<UserControl
    x:Class="AvDashboard.Shell.Views.PendientePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Seccion todavia sin portar a WinUI 3. Se dice con esas palabras y se dice donde
        esta la que si funciona: una pantalla en blanco se lee como un fallo.
    -->
    <StackPanel Padding="0,24,0,0" Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="Todavía no en esta interfaz"
            Message="Esta sección sigue funcionando en la consola de WPF, que se abre con Start-Dev.ps1. Se irá portando aquí una a una." />
    </StackPanel>
</UserControl>
