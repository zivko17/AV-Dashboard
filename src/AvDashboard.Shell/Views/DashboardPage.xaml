<UserControl
    x:Class="AvDashboard.Shell.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvDashboard.Shell"
    xmlns:controls="using:AvDashboard.Shell.Controls">

    <UserControl.Resources>
        <local:HealthBrushConverter x:Key="HealthBrush" />
        <local:SeverityBrushConverter x:Key="SeverityBrush" />
        <local:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:HexBrushConverter x:Key="HexBrush" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="8" Padding="0,8,0,24">

            <TextBlock Text="{Binding NodeSummary}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,0,0,4" />

            <InfoBar
                IsOpen="{Binding Error, Converter={StaticResource StringNotEmpty}, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{Binding Error}" />

            <!--
              Una tarjeta por seccion, con lo que se puede medir de ella dentro.

              Antes esto eran dos filas: una de medidores y otra de tarjetas, y la CPU salia
              en las dos. La seccion es la unidad porque es a donde te lleva el clic; las
              medidas son de la seccion, no al reves.
            -->
            <ItemsRepeater ItemsSource="{Binding Cards}" Margin="0,4,0,8">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="252" MinItemHeight="192"
                                       MinColumnSpacing="10" MinRowSpacing="10" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource TarjetaBotonStyle}"
                                Command="{Binding ActivateCommand}"
                                ToolTipService.ToolTip="Ir a la seccion con el contexto ya filtrado">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                                            Margin="0,0,0,12">
                                    <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Las secciones que se miden: sus medidores. -->
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Gauges}"
                                              Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           VerticalAlignment="Bottom"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{Binding Footnote}" />

                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                           Style="{StaticResource CifraDeMedidor}"
                                                           VerticalAlignment="Bottom"
                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}" />

                                                <!-- La barra repite el dato en forma y no solo
                                                     en color: sin ella, quien no distinga bien
                                                     el verde del ambar se queda sin la mitad. -->
                                                <!--
                                                  El canal se pinta explicito. Con el color
                                                  de pista del sistema, un medidor al 0 %
                                                  no se ve en absoluto y la fila parece que
                                                  le falta algo en vez de estar en reposo.
                                                -->
                                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                             Height="4" Minimum="0" Maximum="100"
                                                             Margin="0,4,0,0"
                                                             Background="#14FFFFFF"
                                                             Value="{Binding Percent, Mode=OneWay, FallbackValue=0}"
                                                             Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Las que no se miden en porcentaje: su veredicto, sin
                                     inventarse un numero que no existe. -->
                                <TextBlock Grid.Row="1" Text="{Binding Primary}"
                                           Style="{StaticResource CifraDeTarjeta}"
                                           VerticalAlignment="Top"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding Primary}"
                                           Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding MoreText}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,4"
                                               Visibility="{Binding MoreText, Converter={StaticResource NotNullToVisibility}}" />

                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <!--
                Latencia: va aquí y no escondida en Red, porque es lo que más veces da la
                pista primero.
            -->
            <TextBlock Text="Latencia — dispositivos críticos"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,12,0,0" />

            <ItemsControl ItemsSource="{Binding PingSeries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,6" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="260" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding Target}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <controls:PingSparkline
                                Grid.Column="1"
                                Height="34"
                                Samples="{Binding Samples}"
                                CeilingMs="{Binding CeilingMs}"
                                LineBrush="{Binding Health, Converter={StaticResource HealthBrush}}" />

                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                       Style="{StaticResource MonoTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Todavía no vigilas ningún equipo"
                Message="Añádelos desde la pestaña Red, en el inventario."
                Visibility="{Binding PingSeries.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />

            <!-- ================================================= ALERTAS ACTIVAS -->
            <TextBlock Text="Alertas activas"
                       Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,0" />

            <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                       Style="{StaticResource MonoTextBlockStyle}" />
                            <TextBlock Grid.Column="2" Text="{Binding Module}"
                                       Style="{StaticResource ChipTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Message}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ninguna alerta activa."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="2,2,0,0"
                       Visibility="{Binding ActiveAlerts.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />

            <!-- Lo que se pulsa con prisa no se busca: la franja va siempre en el mismo sitio. -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                <Button Content="Check pre-show" Command="{Binding RunPreShowCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
                <Button Content="Aplicar perfil" IsEnabled="False"
                        ToolTipService.ToolTip="M10 — Fase 2" />
                <Button Content="Restaurar pantallas" IsEnabled="False"
                        ToolTipService.ToolTip="M15 — Fase 2" />
            </StackPanel>

            <!-- Veredicto de la checklist: un semáforo con la lista de lo que falla. -->
            <StackPanel Visibility="{Binding PreShowResult, Converter={StaticResource NotNullToVisibility}}">
                <TextBlock Text="Checklist pre-show"
                           Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,4" />

                <ItemsControl ItemsSource="{Binding PreShowResult.Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
