<UserControl
    x:Class="AvDashboard.Shell.Views.RedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AvDashboard.Shell"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <local:HealthBrushConverter x:Key="HealthBrush" />
        <local:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
        <local:InverseBooleanConverter x:Key="BoolNot" />
        <local:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Spacing="8" Padding="0,8,0,24">

            <InfoBar
                IsOpen="{Binding Error, Converter={StaticResource StringNotEmpty}, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{Binding Error}" />

            <!-- ===================================================== INTERFACES -->
            <TextBlock Text="Interfaces" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,4,0,0" />

            <ItemsControl ItemsSource="{Binding Interfaces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <tk:SettingsCard
                            Header="{Binding Name}"
                            Description="{Binding Description}"
                            IsClickEnabled="False">

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="{Binding PowerManagementText}"
                                            Visibility="{Binding PowerManagementWarning, Converter={StaticResource BoolToVisibility}}">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14"
                                              Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                    <TextBlock Text="power management"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>

                                <Border Style="{StaticResource ChipBorderStyle}">
                                    <TextBlock Text="{Binding LinkSpeedText}" Style="{StaticResource ChipTextStyle}" />
                                </Border>

                                <TextBlock Text="{Binding ThroughputText}"
                                           MinWidth="110" TextAlignment="Right" VerticalAlignment="Center"
                                           Style="{StaticResource MonoTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel MinWidth="140" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Ipv4Text}"
                                               Style="{StaticResource MonoTextBlockStyle}"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding SubnetMask}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </StackPanel>
                        </tk:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================================================== PING CONTINUO -->
            <TextBlock Text="Ping continuo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,0" />

            <ItemsControl ItemsSource="{Binding Pings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,5" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Target}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding Summary}"
                                       Style="{StaticResource MonoTextBlockStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Todavía no vigilas ningún equipo"
                Message="Márcalo con ★ en el inventario de abajo, o añádelo a mano por su IP."
                Visibility="{Binding Pings.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=invert}" />

            <!-- ================================================ INVENTARIO DE RED -->
            <TextBlock Text="Inventario de red" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="2,16,0,0" />

            <!--
              Alta a mano. Solo IP: el inventario se identifica por direccion, y un nombre
              que resuelve distinto cada dia romperia esa identidad.
            -->
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    MinWidth="150"
                    PlaceholderText="192.168.1.50"
                    Text="{Binding NewAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="Dirección IP. Los nombres de host no valen." />

                <TextBox
                    MinWidth="220"
                    PlaceholderText="Procesador LED"
                    Text="{Binding NewAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="Cómo lo quieres leer a las 19:40." />

                <Button Content="Añadir y vigilar" Command="{Binding AddDeviceCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox
                    MinWidth="220"
                    PlaceholderText="172.31.0.0/24"
                    Text="{Binding ScanRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTipService.ToolTip="CIDR. En blanco, se deduce de la interfaz activa." />

                <Button Content="Escanear" Command="{Binding ScanCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}" />

                <TextBlock Text="{Binding ScanSummary}"
                           VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                IsOpen="{Binding InventoryError, Converter={StaticResource StringNotEmpty}, Mode=OneWay}"
                Severity="Error"
                IsClosable="False"
                Message="{Binding InventoryError}" />

            <ItemsControl ItemsSource="{Binding Inventory}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                              La estrella es lo unico que decide si el equipo entra en el
                              ping. Es un boton y no una casilla porque lo que hace no es
                              marcar un dato, es encender una vigilancia. El comando vive en
                              la fila porque WinUI no tiene RelativeSource AncestorType.
                            -->
                            <Button Grid.Column="0"
                                    Content="{Binding StarGlyph}"
                                    Command="{Binding ToggleCriticalCommand}"
                                    FontSize="15" Padding="8,2" MinWidth="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Vigilar con ping continuo y en el check pre-show" />

                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                       Style="{StaticResource MonoTextBlockStyle}"
                                       VerticalAlignment="Center" />

                            <TextBox Grid.Column="2"
                                     Text="{Binding Alias, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     VerticalAlignment="Center"
                                     PlaceholderText="sin nombre"
                                     ToolTipService.ToolTip="El nombre que quieres leer." />

                            <TextBlock Grid.Column="3" Text="{Binding Vendor}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       ToolTipService.ToolTip="{Binding MacAddress}" />

                            <!-- El texto sale del ViewModel: dice solo lo que se sabe. -->
                            <TextBlock Grid.Column="4" Text="{Binding SeenText}"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{Binding Health, Converter={StaticResource HealthBrush}}"
                                       TextTrimming="CharacterEllipsis" />

                            <Button Grid.Column="5" Content="Quitar"
                                    Command="{Binding RemoveCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="8,2" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Text="El inventario guarda lo que encuentra cada barrido. De los equipos sin ★ solo se sabe lo que dijo el último escaneo: no hay sondeo automático de fondo."
                TextWrapping="Wrap" Margin="2,8,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Visibility="{Binding Inventory.Count, Converter={StaticResource CountToVisibility}}" />

            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
                <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
