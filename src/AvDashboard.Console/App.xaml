<Application x:Class="AvDashboard.Console.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                  Punto de enganche para WPF-UI: cuando entre, sus ControlsDictionary y
                  ThemesDictionary se anaden aqui delante de Theme.xaml y el resto de la
                  aplicacion no se entera. Ver docs/adr/0005.
                -->
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
