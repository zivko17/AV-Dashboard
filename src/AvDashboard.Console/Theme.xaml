<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:AvDashboard.Console.Controls">

    <!-- Lo usa RailItem para anunciar el estado de cada seccion a un lector de pantalla. -->
    <controls:HealthNameConverter x:Key="HealthName" />

    <!--
      Tema Fluent, el de Windows 11 en oscuro.

      Los valores no estan elegidos a ojo: son los tokens de WinUI resueltos sobre el fondo
      base, que es lo que hace que la aplicacion se lea como una pagina de Configuracion y
      no como una aplicacion de escritorio de 2010 pintada de gris.

      El gris sigue siendo antracita, pero neutro: Windows 11 no mete tinte en sus
      superficies, y cualquier desviacion se nota justo al lado de una ventana del sistema.
    -->

    <!-- SolidBackgroundFillColorBase: el fondo de la ventana. -->
    <Color x:Key="BackgroundColor">#FF202020</Color>

    <!-- LayerFillColorDefault: el panel de contenido, un escalon por encima del fondo. -->
    <Color x:Key="LayerColor">#FF272727</Color>

    <!-- CardBackgroundFillColorDefault: blanco al 5% sobre el fondo. -->
    <Color x:Key="SurfaceColor">#FF2D2D2D</Color>

    <!-- CardBackgroundFillColorSecondary / ControlFillColorSecondary. -->
    <Color x:Key="SurfaceRaisedColor">#FF323232</Color>

    <!-- ControlStrokeColorDefault: blanco al 7%. Un borde, no una linea de lapiz. -->
    <Color x:Key="BorderColor">#FF383838</Color>

    <!-- DividerStrokeColorDefault: la linea entre filas de una misma tarjeta. -->
    <Color x:Key="RuleColor">#FF2F2F2F</Color>

    <!-- TextFillColorPrimary / Secondary / Tertiary. -->
    <Color x:Key="TextColor">#FFFFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFC8C8C8</Color>
    <Color x:Key="TextMutedColor">#FF8E8E8E</Color>

    <!--
      Acento. Este es el de serie de Windows; App.xaml.cs lo sustituye en el arranque por el
      que tenga puesto el usuario en Personalizacion, aclarado para fondo oscuro igual que
      hace el propio sistema. Una aplicacion que ignora el acento del usuario nunca parece
      suya.
    -->
    <Color x:Key="AccentColor">#FF60CDFF</Color>
    <Color x:Key="AccentHoverColor">#FF54B8E6</Color>
    <Color x:Key="AccentPressedColor">#FF479FC7</Color>
    <Color x:Key="AccentTextColor">#FF000000</Color>

    <!-- Semaforo. Tres estados y ninguno mas. -->
    <Color x:Key="OkColor">#FF6CCB5F</Color>
    <Color x:Key="WarningColor">#FFFCE100</Color>
    <Color x:Key="CriticalColor">#FFFF99A4</Color>
    <Color x:Key="UnknownColor">#FF6E6E6E</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="LayerBrush" Color="{StaticResource LayerColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="RuleBrush" Color="{StaticResource RuleColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="OkBrush" Color="{StaticResource OkColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CriticalBrush" Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="UnknownBrush" Color="{StaticResource UnknownColor}" />

    <!-- Capas de interaccion: blanco a muy poca opacidad, como en WinUI. -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="#1AFFFFFF" />

    <!--
      Segoe UI Variable es la tipografia de Windows 11; en un Windows 10 no esta y cae a
      Segoe UI, que es exactamente lo que se quiere. Display para titulos, Text para el
      cuerpo: la variable optica es la mitad de la diferencia entre Windows 10 y 11.
    -->
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!--
      La tercera optica, que faltaba. Segoe UI Variable trae tres cortes —Small, Text y
      Display— y no son el mismo dibujo a distinto tamano: Small lleva mas espaciado y los
      remates mas abiertos para que a 12 px no se empaste. Los pies de tarjeta usaban Text,
      que es el corte de 14 a 18, y por eso la letra pequena se leia como de otra aplicacion
      al lado de una ventana del sistema.
    -->
    <FontFamily x:Key="SmallFont">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Escala tipografica de WinUI: Body 14, BodyStrong 14 semibold, Subtitle 20, Title 28. -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SmallFont}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="BodyStrongText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Subtitle. Es el titulo de una pagina de Configuracion de Windows 11. -->
    <Style x:Key="TitleText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- Cabecera de grupo dentro de una pagina: «Dispositivos», «Energia». -->
    <Style x:Key="SectionText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="2,0,0,8" />
    </Style>

    <!--
      La cifra grande de una tarjeta. Display y no Text: por encima de unos 18 px Windows
      cambia al corte optico ancho, y usar el de cuerpo a 28 se ve estrecho y apretado.

      Los numerales tabulares no son un detalle: sin ellos, un 12 % que pasa a 9 % cambia de
      ancho y la caja entera se mueve en cada refresco. Un panel que baila cada segundo se
      lee como roto aunque el dato sea correcto.
    -->
    <Style x:Key="MetricText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- La cifra de un medidor: misma idea, un punto mas pequena. -->
    <Style x:Key="GaugeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--
      La barra de un medidor. La ProgressBar de serie de WPF trae su propio cromo —borde,
      esquinas rectas, un canal mas claro— que no se parece a nada de Windows 11. Esto es lo
      que es: un canal a blanco 8 % y encima el relleno, los dos con radio completo.
    -->
    <Style x:Key="GaugeBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border CornerRadius="2" Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                        <!--
                          Los dos nombres son obligatorios y no decorativos: ProgressBar
                          busca PART_Track y PART_Indicator por nombre y calcula el ancho
                          del segundo contra el primero. Con cualquier otro nombre la barra
                          se queda vacia para siempre, sin dar ningun error.
                        -->
                        <Grid x:Name="PART_Track" ClipToBounds="True">
                            <Border x:Name="PART_Indicator" CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--
      Boton estandar de WinUI. El borde de abajo un poco mas marcado es el detalle que da
      el relieve; sin el, un boton oscuro sobre fondo oscuro es un rectangulo.
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF3A3A3A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF2A2A2A" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#FF262626" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#FF2A2A2A" />
                            <Setter Property="Foreground" Value="{StaticResource UnknownBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El boton de la accion principal de una pagina. Uno por pantalla, como en Windows. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#FF303030" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#FF303030" />
                            <Setter Property="Foreground" Value="{StaticResource UnknownBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton sin cromo, el de las acciones dentro de una fila. -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="30" />
    </Style>

    <!--
      Caja de texto de WinUI: al enfocar no cambia de borde entero, sino que engorda la
      linea de abajo y la pinta del acento.
    -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#FF2B2B2B" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                Margin="1,0,1,0" CornerRadius="0,0,3,3"
                                Background="{StaticResource AccentBrush}"
                                Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF303030" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1F1F1F" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource UnknownBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Casilla de WinUI: cuadrado redondeado que se rellena de acento con el pico dentro. -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="20" Height="20" CornerRadius="3"
                                Background="#FF2B2B2B"
                                BorderBrush="#FF9A9A9A" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Check" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Rail lateral, con la forma del NavigationView de Windows 11: la seleccion es una
      pastilla redondeada y la barra de acento es corta y centrada, no del alto de la fila.
      Ese detalle es la mitad de lo que hace que un menu lateral se vea de Windows 11.
    -->
    <Style x:Key="RailItem" TargetType="ListBoxItem">
        <!--
            Sin esto, un ListBoxItem toma su nombre accesible del ToString() de su contenido,
            que aqui es el ViewModel: un lector de pantalla anunciaba
            «AvDashboard.Client.ViewModels.SystemViewModel» en vez de «Sistema». Va en el
            contenedor y no en la plantilla del elemento porque el nombre lo publica el
            contenedor; ponerlo dentro no cambia lo que se anuncia.

            Ademas es lo unico que queda cuando el panel esta replegado a iconos: ahi el
            titulo desaparece de la pantalla y el glifo no dice nada por si solo.
        -->
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />

        <!--
            El punto de color es la unica senal de que una seccion esta en rojo, y el color
            solo no llega. ItemStatus lo pone en palabras para quien no lo ve.
        -->
        <Setter Property="AutomationProperties.ItemStatus"
                Value="{Binding Health, Converter={StaticResource HealthName}}" />

        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <!-- Ocho y no doce: con el panel replegado a iconos, doce se come el glifo. -->
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4"
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="0,0,0,0" Background="Transparent" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedOverlayBrush}" />
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Interruptor de Windows 11. Apagado es una pastilla vacia con borde; encendido se
      rellena del acento y la bolita se vuelve del color del fondo.

      Antes esto usaba el ambar del semaforo, con el argumento de que aqui «activado» no
      significa «bien». El argumento sigue siendo cierto, pero un interruptor ambar no es
      un control de Windows y se nota; el juicio lo da el punto de estado de la izquierda,
      que para eso esta.
    -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                            Background="#FF2B2B2B"
                            BorderBrush="#FF9A9A9A" BorderThickness="1">
                        <Ellipse x:Name="Knob" Width="12" Height="12"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"
                                 Fill="{StaticResource TextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{StaticResource AccentTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#FF353535" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background"
                                    Value="{StaticResource AccentHoverBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Fila de ajuste, el SettingsCard de WinUI: linea de separacion abajo, alto minimo
      generoso y el control pegado al borde derecho. Es la fila de Configuracion de
      Windows 11 y la de Wintoys, que es la misma.
    -->
    <Style x:Key="TableRow" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
      Expander de Windows 11: la cabecera es una tarjeta con el galon a la derecha dentro de
      un boton circular, y el cuerpo cuelga debajo con el fondo un tono mas oscuro y solo
      las esquinas de abajo redondeadas.
    -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="Toggle" Focusable="True" Cursor="Hand"
                                      Content="{TemplateBinding Header}"
                                      HorizontalContentAlignment="Stretch"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Root"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16,0" Height="64">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" x:Name="ChevronRing"
                                                    Width="32" Height="32" CornerRadius="16"
                                                    Background="Transparent" Margin="12,0,0,0"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                                           FontFamily="{StaticResource IconFont}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Root" Property="CornerRadius" Value="8,8,0,0" />
                                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background"
                                                    Value="{StaticResource SurfaceRaisedBrush}" />
                                            <Setter TargetName="ChevronRing" Property="Background"
                                                    Value="{StaticResource HoverOverlayBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Un tono por debajo de la cabecera: el cuerpo va hundido, como
                             el del SettingsExpander de WinUI. Con el mismo color que la
                             pagina se perderia el borde y la tarjeta dejaria de leerse. -->
                        <Border x:Name="Body" Visibility="Collapsed"
                                Background="#FF242424"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8">
                            <ContentPresenter />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fila seleccionable de una tabla de datos. Sin barra de acento: eso es navegacion. -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedOverlayBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Control segmentado para separar dos vistas de una misma pagina. Windows 11 lo usa en
      Configuracion para «Instaladas / Archivadas»; aqui separa estado de configuracion.
    -->
    <Style x:Key="SegmentItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root" Background="Transparent"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="4"
                            Padding="16,7" MinHeight="34">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverOverlayBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      InfoBar de WinUI: el aviso que va arriba de una pagina. El color del fondo es el
      del sistema para cada severidad, no un rojo cualquiera; asi un aviso de la aplicacion
      y uno de Windows se leen igual de fuerte, que es justo lo que se quiere.
    -->
    <Style x:Key="InfoBar" TargetType="Border">
        <Setter Property="Background" Value="#FF2B2B2B" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- SystemFillColorCautionBackground. -->
    <Style x:Key="InfoBarCaution" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="#FF433519" />
        <Setter Property="BorderBrush" Value="#FF5A4820" />
    </Style>

    <!-- SystemFillColorCriticalBackground. -->
    <Style x:Key="InfoBarCritical" TargetType="Border" BasedOn="{StaticResource InfoBar}">
        <Setter Property="Background" Value="#FF442726" />
        <Setter Property="BorderBrush" Value="#FF5C3230" />
    </Style>

    <!--
      Chip: una etiqueta corta al lado de un nombre. Es como Windows 11 marca «Recomendado»
      o «Administrado por tu organizacion», y sustituye a una columna entera: «Alto» suelto
      en su propia columna no dice de que, pegado al nombre si.
    -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="#FF333333" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipCaution" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#FF433519" />
    </Style>

    <Style x:Key="ChipCritical" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="#FF442726" />
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>

    <!--
      Buscador con lupa y texto de pista, como el AutoSuggestBox de Windows 11. Una caja de
      texto vacia y sin nada dentro se lee como un hueco, no como un buscador.
    -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="38,6,10,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom"
                                Margin="1,0,1,0" CornerRadius="0,0,3,3"
                                Background="{StaticResource AccentBrush}"
                                Visibility="Collapsed" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Margin="13,0,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                   Margin="38,0,10,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF303030" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#FF1F1F1F" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Insignia redondeada: «3 alertas», «12 activos». -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF2B2B2B" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Barra de desplazamiento fina, como la de Windows 11. La de serie de WPF ocupa
      diecisiete pixeles y lleva dos flechas: es de otra decada y se ve a un metro.
    -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Width="6" CornerRadius="3" Margin="4,0"
                            Background="#FF757575" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#FF9A9A9A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"
                                              Focusable="False" Background="Transparent"
                                              BorderThickness="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"
                                              Focusable="False" Background="Transparent"
                                              BorderThickness="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0"
                                                      Focusable="False" Background="Transparent"
                                                      BorderThickness="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="6" CornerRadius="3" Margin="0,4"
                                                            Background="#FF757575" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0"
                                                      Focusable="False" Background="Transparent"
                                                      BorderThickness="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
