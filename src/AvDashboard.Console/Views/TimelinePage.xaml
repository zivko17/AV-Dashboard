<UserControl x:Class="AvDashboard.Console.Views.TimelinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:SeverityBrushConverter x:Key="SeverityBrush" />
        <controls:SectorNameConverter x:Key="SectorName" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Style="{StaticResource CaptionText}" Margin="6,0,0,12" TextWrapping="Wrap"
                   Text="Todos los módulos correlados por timestamp. Es lo que permite reconstruir qué pasó en lugar de discutirlo." />

        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ventana (min):" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                <TextBox Width="70" Margin="8,0,0,0" Text="{Binding WindowMinutes, UpdateSourceTrigger=LostFocus}" />
                <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"
                                       Text="{Binding Timestamp, StringFormat='{}{0:dd/MM HH:mm:ss}'}" />
                            <TextBlock Grid.Column="2" Text="{Binding Module}" Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}"
                                       Text="{Binding Sector, Converter={StaticResource SectorName}}" />
                            <TextBlock Grid.Column="4" Text="{Binding Kind}" FontFamily="{StaticResource MonoFont}"
                                       Style="{StaticResource CaptionText}" />
                            <TextBlock Grid.Column="5" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
