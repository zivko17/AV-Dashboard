<UserControl x:Class="AvDashboard.Console.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Perfiles" Style="{StaticResource SectionText}" />

                <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource RowItem}"
                         MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Origin}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Steps}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding Disruptive}"
                                           Foreground="{StaticResource WarningBrush}" FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Disruptive, Converter={StaticResource StringToVisibility}}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                                           Text="{Binding Description}" TextWrapping="Wrap"
                                           Margin="0,2,0,0" Style="{StaticResource CaptionText}"
                                           Visibility="{Binding Description, Converter={StaticResource StringToVisibility}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Aplicar" IsEnabled="False"
                            ToolTip="Llega con los actuadores de la Fase 2, con snapshot previo y rollback." />
                    <Button Content="Exportar a fichero" Command="{Binding ExportCommand}" Margin="10,0,0,0" />
                    <Button Content="Importar de fichero" Command="{Binding ImportCommand}" Margin="10,0,0,0" />
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Style="{StaticResource CaptionText}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}"
                Visibility="{Binding Selected, Converter={StaticResource NotNullToVisibility}}"
                Margin="6,0,6,20">
            <StackPanel DataContext="{Binding Selected}">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding StepRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Number}" FontFamily="{StaticResource MonoFont}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionId}" FontFamily="{StaticResource MonoFont}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
