<UserControl x:Class="AvDashboard.Console.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="6,20,6,6" MaxWidth="720" HorizontalAlignment="Left">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="10,3"
                    HorizontalAlignment="Left" Margin="0,0,0,14">
                <TextBlock Text="{Binding Phase}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
            </Border>
            <TextBlock Text="{Binding What}" TextWrapping="Wrap" LineHeight="22" />
            <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="Esta sección aparece vacía a propósito. Una aplicación que esconde lo que todavía no hace obliga a llevar el roadmap en la cabeza." />
        </StackPanel>
    </Border>
</UserControl>
