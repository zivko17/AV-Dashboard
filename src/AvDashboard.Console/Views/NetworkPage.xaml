<UserControl x:Class="AvDashboard.Console.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:InverseBooleanConverter x:Key="BoolNot" />
        <controls:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <controls:CountToVisibilityConverter x:Key="CountToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Interfaces" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding Interfaces}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Description}" />
                                <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}"
                                           Text="{Binding Ipv4Text}" />
                                <TextBlock Grid.Column="2" FontFamily="{StaticResource MonoFont}" Text="{Binding SubnetMask}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}"
                                           Text="{Binding LinkSpeedText}" />
                                <TextBlock Grid.Column="4" Style="{StaticResource CaptionText}"
                                           Text="{Binding ThroughputText}" />
                                <TextBlock Grid.Column="5" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PowerManagementWarning}" Value="True">
                                                    <Setter Property="Text" Value="{Binding PowerManagementText}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Ping continuo" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding Pings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Target}" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock TextWrapping="Wrap"
                           Text="Todavía no vigilas ningún equipo. Márcalo con ★ en el inventario de abajo, o añádelo a mano por su IP.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Pings.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Inventario de red" Style="{StaticResource SectionText}" />

                <!--
                  Alta a mano. Solo IP: el inventario se identifica por direccion, y un
                  nombre que resuelve distinto cada dia romperia esa identidad.
                -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="150" Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             ToolTip="Dirección IP, por ejemplo 192.168.1.50. Los nombres de host no valen." />
                    <TextBox Width="220" Margin="8,0,0,0"
                             Text="{Binding NewAlias, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Cómo lo quieres leer a las 19:40: «Procesador LED», «Switch Dante»…" />
                    <Button Content="Añadir y vigilar" Command="{Binding AddDeviceCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBox Width="150" Text="{Binding ScanRange, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}"
                             ToolTip="CIDR, por ejemplo 172.31.0.0/24. En blanco, se deduce de la interfaz activa." />
                    <Button Content="Escanear" Command="{Binding ScanCommand}" Margin="8,0,0,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}" />
                    <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>

                <TextBlock Text="{Binding InventoryError}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource CriticalBrush}"
                           Visibility="{Binding InventoryError, Converter={StaticResource NotNullToVisibility}}" />

                <ItemsControl ItemsSource="{Binding Inventory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--
                                  La estrella es lo unico que decide si el equipo entra en el
                                  ping. Es un boton y no una casilla porque lo que hace no es
                                  marcar un dato, es encender una vigilancia.
                                -->
                                <Button Grid.Column="0" Command="{Binding ToggleCriticalCommand}"
                                        Style="{StaticResource SubtleButton}" Padding="4,0" FontSize="15"
                                        Content="{Binding StarGlyph}"
                                        ToolTip="Vigilar con ping continuo y en el check pre-show" />

                                <TextBlock Grid.Column="1" Text="{Binding IpAddress}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center" />

                                <TextBox Grid.Column="2" Text="{Binding Alias, UpdateSourceTrigger=LostFocus}"
                                         Margin="6,0" VerticalAlignment="Center"
                                         ToolTip="El nombre que quieres leer. Enter para guardar.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveAliasCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <TextBlock Grid.Column="3" Text="{Binding Vendor}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionText}"
                                           ToolTip="{Binding MacAddress}" />

                                <!-- El texto sale del ViewModel: dice solo lo que se sabe. -->
                                <TextBlock Grid.Column="4" Text="{Binding SeenText}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionText}"
                                           Foreground="{Binding Health, Converter={StaticResource HealthBrush}}" />

                                <Button Grid.Column="5" Content="Quitar" Command="{Binding RemoveCommand}"
                                        Style="{StaticResource SubtleButton}" Padding="6,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                           Text="El inventario guarda lo que encuentra cada barrido. De los equipos sin ★ solo se sabe lo que dijo el último escaneo: no hay sondeo automático de fondo."
                           Visibility="{Binding Inventory.Count, Converter={StaticResource CountToVisibility}}" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="6,4,0,20">
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
