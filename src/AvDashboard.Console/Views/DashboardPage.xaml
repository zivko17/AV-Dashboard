<UserControl x:Class="AvDashboard.Console.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:SeverityBrushConverter x:Key="SeverityBrush" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:NotNullToVisibilityConverter x:Key="NotNullToVisibility" />
        <controls:HexBrushConverter x:Key="HexBrush" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding NodeSummary}" Style="{StaticResource CaptionText}" Margin="2,0,0,10" />

        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!--
          Una tarjeta por seccion, con lo que se puede medir de ella dentro.

          Antes esto eran dos filas: una de medidores y otra de tarjetas, y la CPU salia en
          las dos. La seccion es la unidad porque es a donde te lleva el clic; las medidas
          son de la seccion, no al reves.
        -->
        <ItemsControl ItemsSource="{Binding Cards}" Margin="0,0,-10,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,10,10" MinHeight="184"
                            Cursor="Hand" Padding="18,16"
                            ToolTip="Ir a la sección con el contexto ya filtrado">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding ActivateCommand}" />
                        </Border.InputBindings>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontWeight="SemiBold"
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>

                            <!-- Las secciones que se miden: sus medidores, lo peor primero. -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Gauges}"
                                          Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                       VerticalAlignment="Bottom" Margin="0,0,8,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Footnote}" />

                                            <!-- La cifra es el color: se lee de un vistazo de pie. -->
                                            <TextBlock Grid.Column="1" Text="{Binding PercentText}"
                                                       Style="{StaticResource GaugeText}"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}" />

                                            <!-- La barra repite el dato en forma y no solo en
                                                 color: sin ella, quien no distinga bien el verde
                                                 del ambar se queda sin la mitad del dato. -->
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                                         Style="{StaticResource GaugeBar}"
                                                         VerticalAlignment="Bottom" Margin="0,4,0,0"
                                                         Value="{Binding Percent, Mode=OneWay, FallbackValue=0}"
                                                         Foreground="{Binding ColorHex, Converter={StaticResource HexBrush}}" />

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Las que no se miden en porcentaje: su veredicto, sin inventarse
                                 un numero que no existe. -->
                            <TextBlock Grid.Row="1" Text="{Binding Primary}"
                                       Style="{StaticResource MetricText}" FontSize="22"
                                       VerticalAlignment="Top" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Primary}"
                                       Visibility="{Binding HasGauges, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding MoreText}" Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,4"
                                           Visibility="{Binding MoreText, Converter={StaticResource NotNullToVisibility}}" />

                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Latencia: va en el dashboard y no escondida en Red, porque es lo que mas
             veces da la pista primero. -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Latencia — dispositivos críticos" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding PingSeries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                    <TextBlock Text="{Binding Target}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <controls:PingSparkline Grid.Column="1" Height="34" Margin="10,0"
                                                        Samples="{Binding Samples}"
                                                        CeilingMs="{Binding CeilingMs}"
                                                        LineBrush="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Grid.Column="2" Text="{Binding Summary}" FontFamily="{StaticResource MonoFont}"
                                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="0,8,0,0"
                           Text="Todavía no vigilas ningún equipo. Añádelos desde la pestaña Red, en el inventario.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PingSeries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Alertas activas -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Alertas activas" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding ActiveAlerts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontFamily="{StaticResource MonoFont}"
                                           Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="2" Text="{Binding Module}"
                                           Style="{StaticResource CaptionText}" />
                                <TextBlock Grid.Column="3" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Franja de acciones rapidas: lo que se pulsa con prisa no se busca. -->
        <StackPanel Orientation="Horizontal" Margin="6,4,0,20">
            <Button Content="Check pre-show" Command="{Binding RunPreShowCommand}" />
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
            <Button Content="Aplicar perfil" IsEnabled="False" ToolTip="M10 — Fase 2" />
            <Button Content="Restaurar pantallas" IsEnabled="False" ToolTip="M15 — Fase 2" />
        </StackPanel>

        <!-- Veredicto de la checklist: un semaforo con la lista de lo que falla. -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,20"
                Visibility="{Binding PreShowResult, Converter={StaticResource NotNullToVisibility}}">
            <StackPanel>
                <TextBlock Text="Checklist pre-show" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding PreShowResult.Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Fill="{Binding State, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
