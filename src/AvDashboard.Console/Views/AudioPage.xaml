<UserControl x:Class="AvDashboard.Console.Views.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:CountToVisibilityConverter x:Key="CountToVisibility" />

        <DataTemplate x:Key="DeviceRow">
            <Border Style="{StaticResource TableRow}" Padding="4,9" MinHeight="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />

                    <StackPanel Grid.Column="1" Margin="12,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Text="Predeterminado" Margin="0,1,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding Direction}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding Format}"
                               Style="{StaticResource MonoText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="4" Text="{Binding Declared}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMismatch}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <controls:LevelMeter Grid.Column="5" Height="10" MinWidth="120"
                                         VerticalAlignment="Center" Peak="{Binding Peak}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Los inactivos no tienen formato ni nivel: enseñar columnas vacías es ruido. -->
        <DataTemplate x:Key="InactiveDeviceRow">
            <Border Style="{StaticResource TableRow}" Padding="4,8" MinHeight="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Fill="{StaticResource UnknownBrush}" />

                    <TextBlock Grid.Column="1" Margin="12,0,14,0" Text="{Binding Name}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2" Text="{Binding Direction}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding StateText}"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <Border Style="{StaticResource InfoBarCaution}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16"
                           Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top"
                           Margin="0,1,12,0" />
                <TextBlock Text="{Binding MismatchSummary}" TextWrapping="Wrap" MaxWidth="900" />
            </StackPanel>
        </Border>

        <!-- Los que están sonando. -->
        <Border Style="{StaticResource Card}" Padding="12,4,12,4">
            <StackPanel>
                <Grid Margin="4,12,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Dispositivos activos"
                               Style="{StaticResource SectionText}" Margin="0" />
                    <Border Grid.Column="1" Style="{StaticResource Badge}">
                        <TextBlock Text="{Binding ActiveCount}" FontSize="12" />
                    </Border>
                </Grid>

                <Grid Margin="4,6,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="210" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="8" />
                    <TextBlock Grid.Column="1" Text="Dispositivo" Style="{StaticResource CaptionText}" Margin="12,0,0,0" />
                    <TextBlock Grid.Column="2" Text="Dirección" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="3" Text="Formato en uso" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="4" Text="Declarado" Style="{StaticResource CaptionText}" />
                    <TextBlock Grid.Column="5" Text="Nivel" Style="{StaticResource CaptionText}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding ActiveDevices}"
                              ItemTemplate="{StaticResource DeviceRow}" />

                <TextBlock Text="Ningún endpoint activo. Si esperabas alguno, mira la lista de abajo."
                           Margin="4,10,0,12">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveCount}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!--
            Los que Windows recuerda. Plegado por defecto: nadie abre esta página para ver
            una tarjeta de sonido que quitó hace un año, pero cuando falta una interfaz es
            lo primero que hay que mirar.
        -->
        <Expander Visibility="{Binding InactiveCount, Converter={StaticResource CountToVisibility}}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="16"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,14,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dispositivos inactivos" Style="{StaticResource BodyStrongText}" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                                   Text="Registrados en Windows y ahora mismo desenchufados, apagados o ausentes." />
                    </StackPanel>
                    <Border Style="{StaticResource Badge}" Margin="14,0,0,0">
                        <TextBlock Text="{Binding InactiveCount}" FontSize="12" />
                    </Border>
                </StackPanel>
            </Expander.Header>

            <ItemsControl ItemsSource="{Binding InactiveDevices}"
                          ItemTemplate="{StaticResource InactiveDeviceRow}"
                          Margin="12,4,12,8" />
        </Expander>

        <Border Style="{StaticResource Card}" Margin="0,12,0,8">
            <StackPanel>
                <TextBlock Text="Drivers ASIO" Style="{StaticResource SectionText}" />
                <ItemsControl ItemsSource="{Binding AsioDrivers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding DriverPath}"
                                           Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PTP / IEEE 1588" Style="{StaticResource SectionText}" />
                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionText}" MaxWidth="900"
                           HorizontalAlignment="Left"
                           Text="Requiere Npcap en modo compatible con WinPcap. PTP no se puede leer con sockets normales, así que este panel se queda vacío hasta la Fase 5 y hasta que Npcap esté instalado. Cuando lo esté: Grandmaster del segmento, offset, deriva y aviso de cambio de Grandmaster." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,20">
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
