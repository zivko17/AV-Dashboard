<UserControl x:Class="AvDashboard.Console.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:CountToVisibilityConverter x:Key="CountToVisibility" />
        <controls:InverseBooleanConverter x:Key="BoolNot" />

        <!--
            Una sola plantilla de fila para todo: hallazgos, diagnóstico, sin lectura y el
            catálogo. Alto fijo y las mismas columnas siempre, así que todas las barras
            miden lo mismo y la vista se lee como una rejilla en lugar de como cinco tablas
            distintas. Cada celda sabe desaparecer cuando no aplica; lo que no cambia es
            dónde está.

            Es la forma del SettingsCard de Windows 11: nombre y una línea de descripción a
            la izquierda, el valor a la derecha y el control al final.
        -->
        <DataTemplate x:Key="SettingRowTemplate">
            <Border Style="{StaticResource TableRow}" Height="68" MinHeight="68" Padding="16,0">
                <Grid>
                    <!--
                        El valor va en columna automatica y no fija a proposito. Con una
                        columna fija, entre el final de la descripcion y el valor quedaba un
                        hueco muerto que cambiaba de tamano en cada fila, y la fila se leia
                        como tres islas sueltas en vez de como una linea.

                        Automatica y alineada a la derecha, el valor queda pegado al control
                        y todos los valores terminan en la misma vertical, que es la
                        alineacion que de verdad sirve para recorrer la tabla con la vista.
                    -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="Auto" MaxWidth="270" />
                        <ColumnDefinition Width="150" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                             Margin="0,0,14,0"
                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />

                    <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MaxWidth="360" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                       VerticalAlignment="Center" />

                            <Border Grid.Column="1" Style="{StaticResource Chip}"
                                    Visibility="{Binding ShowGroup, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding GroupName}" Style="{StaticResource ChipText}" />
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Chip}"
                                    Visibility="{Binding ImpactChip, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding ImpactChip}" Style="{StaticResource ChipText}" />
                            </Border>

                            <!-- La contrapartida en corto; el porqué entero, en el tooltip. -->
                            <Border Grid.Column="3" Style="{StaticResource ChipCaution}"
                                    ToolTip="{Binding Warning}"
                                    Visibility="{Binding RiskChip, Converter={StaticResource StringToVisibility}}">
                                <TextBlock Text="{Binding RiskChip}" Style="{StaticResource ChipText}"
                                           Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </Grid>

                        <!--
                            Una línea y con puntos suspensivos, no un párrafo. Windows 11
                            escribe una línea por ajuste; en cuanto una fila crece, la lista
                            deja de ser una rejilla y hay que volver a buscar cada control.
                        -->
                        <TextBlock Text="{Binding Rationale}" Margin="0,3,0,0"
                                   Style="{StaticResource CaptionText}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Rationale}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock Text="{Binding Current}" TextTrimming="CharacterEllipsis"
                                   TextAlignment="Right" ToolTip="{Binding Source}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health}" Value="Critical">
                                            <Setter Property="Foreground" Value="{StaticResource CriticalBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Health}" Value="Warning">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Health}" Value="Unknown">
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding TargetLine}" Style="{StaticResource CaptionText}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                                   TextAlignment="Right" ToolTip="{Binding TargetLine}"
                                   Visibility="{Binding TargetLine, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>

                    <Grid Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding IsOn, Mode=OneWay}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                      Command="{Binding DataContext.ToggleCommand,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" />

                        <Button Content="Aplicar" HorizontalAlignment="Right" Margin="0"
                                Padding="14,5" FontSize="13"
                                ToolTip="Llevar este ajuste a su valor objetivo"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                Command="{Binding DataContext.ApplyTargetCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding CanApplyTarget, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Sin control: se dice por qué en corto, y el porqué largo en el tooltip. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    ToolTip="{Binding NotWritableReason}"
                                    Visibility="{Binding NotWritableShort, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}"
                                       FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding NotWritableShort}" Margin="6,0,0,0"
                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- Pestañas a la izquierda y la acción de la página a la derecha, como en Windows. -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF262626" CornerRadius="6" Padding="3"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="SystemTab"
                                 Content="Estado"
                                 IsChecked="{Binding ShowSettings, Converter={StaticResource BoolNot}, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource SegmentItem}" GroupName="SystemTab"
                                 Content="Configuración" Margin="0"
                                 IsChecked="{Binding ShowSettings, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Margin="0"
                    Command="{Binding RefreshCommand}" ToolTip="Volver a auditar el sistema (F5)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="14"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Actualizar" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Style="{StaticResource InfoBarCritical}"
                Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================= ESTADO -->
        <StackPanel Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility},
                                 ConverterParameter=invert}">

            <UniformGrid Columns="4" Margin="0,0,-8,4">
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="16,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CPU" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:0}%'}"
                                   Style="{StaticResource MetricText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="16,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Memoria" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0:0}%'}"
                                   Style="{StaticResource MetricText}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="16,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Activo desde" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding Uptime}" FontSize="20" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,8" Padding="16,14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Plan de energía" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="{Binding PowerPlan}" FontSize="18" FontWeight="SemiBold"
                                   FontFamily="{StaticResource DisplayFont}" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PowerPlan}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- El titular, con el recuento en chips. -->
            <Border Style="{StaticResource Card}" Margin="0,4,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                             Margin="0,0,14,0"
                             Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateHeadline}" Style="{StaticResource BodyStrongText}"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0">
                            <Run Text="{Binding OkCount, Mode=OneWay}" />
                            <Run Text="de" />
                            <Run Text="{Binding CatalogCount, Mode=OneWay}" />
                            <Run Text="ajustes coinciden con el objetivo." />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource ChipCritical}"
                                Visibility="{Binding CriticalCount, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource CriticalBrush}"
                                       Text="{Binding CriticalCount, StringFormat='{}{0} en rojo'}" />
                        </Border>
                        <Border Style="{StaticResource ChipCaution}"
                                Visibility="{Binding WarningCount, Converter={StaticResource CountToVisibility}}">
                            <TextBlock Style="{StaticResource ChipText}"
                                       Foreground="{StaticResource WarningBrush}"
                                       Text="{Binding WarningCount, StringFormat='{}{0} en ámbar'}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lo que hay que mirar. -->
            <StackPanel Visibility="{Binding Findings.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="Lo que hay que mirar" Style="{StaticResource SectionText}" />
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding Findings}"
                                  ItemTemplate="{StaticResource SettingRowTemplate}" />
                </Border>
            </StackPanel>

            <!-- Hechos de la máquina, no ajustes. -->
            <StackPanel Visibility="{Binding Diagnostics.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="Diagnóstico" Style="{StaticResource SectionText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="2,0,0,8"
                           Text="Cosas que le pasan a este equipo y que no se configuran desde ninguna parte." />
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding Diagnostics}"
                                  ItemTemplate="{StaticResource SettingRowTemplate}" />
                </Border>
            </StackPanel>

            <!-- Lo que Windows no ha dejado consultar. -->
            <StackPanel Visibility="{Binding Unreadable.Count, Converter={StaticResource CountToVisibility}}">
                <TextBlock Text="Sin lectura" Style="{StaticResource SectionText}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="2,0,0,8"
                           Text="Windows no ha dejado consultarlos. No es un fallo del equipo: casi siempre es falta de privilegios." />
                <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding Unreadable}"
                                  ItemTemplate="{StaticResource SettingRowTemplate}" />
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- ====================================================== CONFIGURACIÓN -->
        <StackPanel Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibility}}">

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                         Tag="Buscar un ajuste"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Busca por nombre, motivo o clave del registro" />
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Margin="16,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding CatalogCount, Mode=OneWay}" />
                    <Run Text="ajustes en el catálogo," />
                    <Run Text="{Binding WritableCount, Mode=OneWay}" />
                    <Run Text="se pueden cambiar desde aquí. Cada cambio queda registrado en el Timeline con el valor que había antes." />
                </TextBlock>
            </Grid>

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander IsExpanded="True">
                            <Expander.Header>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                               FontFamily="{StaticResource IconFont}" FontSize="18"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyStrongText}" />
                                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource CaptionText}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Border Style="{StaticResource ChipCritical}"
                                                Visibility="{Binding CriticalCount, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="{Binding CriticalText}" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource CriticalBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource ChipCaution}"
                                                Visibility="{Binding WarningCount, Converter={StaticResource CountToVisibility}}">
                                            <TextBlock Text="{Binding WarningText}" Style="{StaticResource ChipText}"
                                                       Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>

                            <ItemsControl ItemsSource="{Binding Rows}"
                                          ItemTemplate="{StaticResource SettingRowTemplate}" />
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource CaptionText}" Margin="2,16,0,0" TextWrapping="Wrap"
                       MaxWidth="900" HorizontalAlignment="Left"
                       Text="Los ajustes con el candado no se pueden escribir desde aquí: unos porque Windows no deja, y los de riesgo de seguridad porque se tocan a mano a propósito." />
        </StackPanel>

        <!-- Resultado de la última escritura. Se queda hasta la siguiente. -->
        <TextBlock Text="{Binding Summary}" Style="{StaticResource CaptionText}"
                   Margin="2,18,0,24" TextWrapping="Wrap" MaxWidth="900"
                   HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
