<UserControl x:Class="AvDashboard.Console.Views.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AvDashboard.Console.Controls">
    <UserControl.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:InverseBooleanConverter x:Key="BoolNot" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="Sistema y rendimiento" Style="{StaticResource TitleText}" Margin="6,0,0,12" />

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource CriticalBrush}" Margin="6,0,0,8"
                   TextWrapping="Wrap"
                   Visibility="{Binding Error, Converter={StaticResource StringToVisibility}}" />

        <!-- Estado antes que control. -->
        <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="CPU" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding CpuPercent, StringFormat='{}{0:0}%'}" Style="{StaticResource MetricText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="RAM" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding MemoryPercent, StringFormat='{}{0:0}%'}" Style="{StaticResource MetricText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ACTIVO DESDE" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding Uptime}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="PLAN DE ENERGÍA" Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding PowerPlan}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!--
            El catalogo, agrupado y filtrado. Arranca mostrando solo lo que difiere del
            objetivo: cuarenta y dos filas en una lista plana no se leen, y el dia del show
            lo que quieres son las cinco que hay que mirar.
        -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding OnlyDeviations}"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Grid.Column="1" Text="Solo lo que difiere del objetivo"
                               VerticalAlignment="Center" Margin="0,0,24,0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding OnlyHighImpact}" VerticalAlignment="Center"
                                  Margin="0,0,6,0" />
                        <TextBlock Text="Solo impacto alto" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,14" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="True" Margin="0,0,0,14">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                 Margin="0,0,10,0"
                                                 Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Counters}" Margin="14,0,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Expander.Header>

                                <!--
                                    Cada ajuste es una fila con linea de separacion: nombre y
                                    motivo a la izquierda, valor y objetivo en columnas fijas, y
                                    el control a la derecha. Con cuarenta y ocho filas, las
                                    lineas son lo que hace que se lea como una tabla.
                                -->
                                <Border BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,1,0,0"
                                        Margin="26,8,0,0">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource TableRow}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" MinWidth="260" />
                                                            <ColumnDefinition Width="210" />
                                                            <ColumnDefinition Width="220" />
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="150" />
                                                        </Grid.ColumnDefinitions>

                                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                                 VerticalAlignment="Top" Margin="0,6,12,0"
                                                                 Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />

                                                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextWrapping="Wrap" />
                                                            <!--
                                                                El motivo va siempre visible, como en
                                                                los ajustes de Windows 11. Solo en los
                                                                que fallan se leia como un reproche;
                                                                en todos se lee como una explicacion.
                                                            -->
                                                            <TextBlock Text="{Binding Rationale}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       Style="{StaticResource CaptionText}"
                                                                       Visibility="{Binding Rationale, Converter={StaticResource StringToVisibility}}" />
                                                            <TextBlock Text="{Binding Warning}"
                                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource WarningBrush}"
                                                                       Visibility="{Binding Warning, Converter={StaticResource StringToVisibility}}" />
                                                        </StackPanel>

                                                        <TextBlock Grid.Column="2" Text="{Binding Current}"
                                                                   FontFamily="Consolas"
                                                                   VerticalAlignment="Top" Margin="0,1,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Source}" />

                                                        <TextBlock Grid.Column="3" Text="{Binding Target}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Top" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Grid.Column="4" Text="{Binding Impact}"
                                                                   Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Top" Margin="0,2,0,0" />

                                                        <!-- El control. Interruptor, boton, o el motivo de que no haya. -->
                                                        <Grid Grid.Column="5" HorizontalAlignment="Right"
                                                              VerticalAlignment="Top">
                                                            <ToggleButton Style="{StaticResource Switch}"
                                                                          IsChecked="{Binding IsOn, Mode=OneWay}"
                                                                          IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                                                          Command="{Binding DataContext.ToggleCommand,
                                                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                          CommandParameter="{Binding}"
                                                                          Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisibility}}" />

                                                            <Button Content="Aplicar objetivo"
                                                                    Padding="10,4" FontSize="12"
                                                                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNot}}"
                                                                    Command="{Binding DataContext.ApplyTargetCommand,
                                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding CanApplyTarget, Converter={StaticResource BoolToVisibility}}" />

                                                            <TextBlock Text="{Binding NotWritableReason}"
                                                                       TextWrapping="Wrap" FontSize="11"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       Visibility="{Binding NotWritableReason, Converter={StaticResource StringToVisibility}}" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource CaptionText}" Margin="0,14,0,0" TextWrapping="Wrap"
                           Text="Cada cambio queda registrado en el Timeline con el valor que había antes. Los ajustes sin control no se pueden escribir desde aquí: unos porque Windows no deja, y los de riesgo de seguridad porque se tocan a mano a propósito." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="6,4,0,20">
            <Button Content="Actualizar" Command="{Binding RefreshCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
