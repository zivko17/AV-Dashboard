<Window x:Class="AvDashboard.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AvDashboard.Console.ViewModels"
        xmlns:views="clr-namespace:AvDashboard.Console.Views"
        xmlns:controls="clr-namespace:AvDashboard.Console.Controls"
        Title="AV Dashboard"
        Height="900" Width="1500"
        MinHeight="720" MinWidth="1280"
        Background="{StaticResource BackgroundBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:SeverityBrushConverter x:Key="SeverityBrush" />
        <controls:SectorNameConverter x:Key="SectorName" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:CountToVisibilityConverter x:Key="CountToVisibility" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />

        <!-- Cada ViewModel de pagina sabe pintarse; el ContentControl solo cambia de contenido. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <views:TimelinePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderPage />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Ctrl+K: la paleta de comandos. Bajo presion no se navega una UI, se escribe. -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding TogglePaletteCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Marca -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,1" Padding="18,14">
            <TextBlock Text="AV DASHBOARD" FontWeight="Bold" FontSize="15"
                       Foreground="{StaticResource AccentBrush}" />
        </Border>

        <!-- Barra superior persistente: nodo, semaforo, perfil y panico. -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nodo:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding NodeName}" Margin="6,0,16,0" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                             Fill="{Binding NodeHealth, Converter={StaticResource HealthBrush}}" />
                    <TextBlock Text="{Binding ConnectionStatus}" Margin="8,0,0,0"
                               Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <TextBlock Text="Perfil:" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveProfile}" Margin="6,0,16,0" VerticalAlignment="Center" />
                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="8,2"
                            Visibility="{Binding ActiveAlertCount, Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="{Binding ActiveAlertCount, StringFormat='{}{0} alertas'}"
                                   Foreground="{StaticResource WarningBrush}" FontSize="12" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="4" Content="⚡ Pánico" IsEnabled="False"
                        ToolTip="Acciones de pánico (M15) — llega en la Fase 2." />
            </Grid>
        </Border>

        <!-- Rail lateral. Con doce secciones un TabControl obliga a scroll horizontal. -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding Current, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource RailItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16" Width="24" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            <Ellipse Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center"
                                     Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Area de contenido -->
        <Grid Grid.Row="1" Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                <ContentControl Content="{Binding Current}" />
            </ScrollViewer>

            <!-- Paleta de comandos superpuesta -->
            <Border Background="#CC0B0E11" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource Card}" Width="640" MaxHeight="460"
                        VerticalAlignment="Top" Margin="0,80,0,0"
                        Background="{StaticResource SurfaceRaisedBrush}">
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="16" Padding="10,8" Margin="0,0,0,10"
                                 x:Name="PaletteInput" />
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}" Margin="0,10,0,0"
                                   Text="Mismos nombres que av-light-tools. Esc para cerrar." />
                        <ListBox ItemsSource="{Binding Palette.Results}"
                                 SelectedItem="{Binding Palette.Selected, Mode=TwoWay}"
                                 HorizontalContentAlignment="Stretch"
                                 ItemContainerStyle="{StaticResource RailItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding ModuleId}"
                                                   Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
