<Window x:Class="AvDashboard.Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AvDashboard.Console.ViewModels"
        xmlns:views="clr-namespace:AvDashboard.Console.Views"
        xmlns:controls="clr-namespace:AvDashboard.Console.Controls"
        Title="AV Dashboard"
        Height="900" Width="1500"
        MinHeight="720" MinWidth="1280"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <controls:HealthBrushConverter x:Key="HealthBrush" />
        <controls:SeverityBrushConverter x:Key="SeverityBrush" />
        <controls:SectorNameConverter x:Key="SectorName" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:CountToVisibilityConverter x:Key="CountToVisibility" />
        <controls:StringToVisibilityConverter x:Key="StringToVisibility" />
        <controls:InverseBooleanConverter x:Key="BoolNot" />

        <!-- Cada ViewModel de pagina sabe pintarse; el ContentControl solo cambia de contenido. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AudioViewModel}">
            <views:AudioPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
            <views:ProfilesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VideoViewModel}">
            <views:VideoPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}">
            <views:NetworkPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
            <views:ServicesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
            <views:TimelinePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderPage />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Ctrl+K: la paleta de comandos. Bajo presion no se navega una UI, se escribe. -->
        <KeyBinding Key="K" Modifiers="Control" Command="{Binding TogglePaletteCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentCommand}" />
    </Window.InputBindings>

    <!--
        La forma es la del NavigationView de Windows 11: el panel de navegacion ocupa todo el
        alto y se deja ver el fondo del sistema, y el contenido es una superficie propia con
        la esquina de arriba a la izquierda redondeada. Es literalmente la silueta de la
        Configuracion de Windows, y es lo que hace que la ventana se lea como del sistema
        antes de mirar un solo control.
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Panel de navegacion. Sin fondo propio: encima va el Mica de la ventana. -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Padding="20,14,16,14">
                <StackPanel>
                    <TextBlock Text="AV Dashboard" FontSize="15" FontWeight="SemiBold"
                               FontFamily="{StaticResource DisplayFont}" />
                    <TextBlock Text="{Binding NodeName}" Style="{StaticResource CaptionText}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- La paleta abajo del todo, como el boton de cuenta de la Configuracion. -->
            <Border DockPanel.Dock="Bottom" Padding="8,4,8,10">
                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" Margin="0"
                        Command="{Binding TogglePaletteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Width="28" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="Buscar comando" VerticalAlignment="Center" />
                        <TextBlock Text="Ctrl+K" Style="{StaticResource CaptionText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <ListBox ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding Current, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource RailItem}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" />
                            <Ellipse Grid.Column="2" Width="7" Height="7" Margin="8,0,2,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Health, Converter={StaticResource HealthBrush}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Superficie de contenido. -->
        <Border Grid.Column="1" Background="{StaticResource LayerBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
            <Grid>
                <DockPanel>
                    <!--
                        Cabecera: el titulo de la pagina a la izquierda y la identidad del
                        nodo a la derecha. El titulo vive aqui y no dentro de cada pagina
                        porque asi no se mueve al cambiar de seccion y no gasta una linea
                        de contenido, que es como lo hace la Configuracion de Windows.
                    -->
                    <Border DockPanel.Dock="Top" Padding="28,14,28,12"
                            BorderBrush="{StaticResource RuleBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Current.Title}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                         Fill="{Binding NodeHealth, Converter={StaticResource HealthBrush}}" />
                                <TextBlock Text="{Binding NodeName}" Margin="9,0,0,0"
                                           Style="{StaticResource BodyStrongText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionStatus}" Margin="9,0,18,0"
                                           Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                                <TextBlock Text="Perfil" Style="{StaticResource CaptionText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveProfile}" Margin="6,0,14,0"
                                           VerticalAlignment="Center" />
                                <Border Style="{StaticResource Badge}"
                                        Visibility="{Binding ActiveAlertCount, Converter={StaticResource CountToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{StaticResource WarningBrush}" />
                                        <TextBlock Text="{Binding ActiveAlertCount, StringFormat='{}{0} alertas'}"
                                                   Foreground="{StaticResource WarningBrush}" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,20,24">
                        <!-- El ancho de linea de la Configuracion de Windows: leer una tabla
                             de mil pixeles de ancho cansa, y a partir de ahi no cabe mas. -->
                        <ContentControl Content="{Binding Current}" MaxWidth="1180"
                                        HorizontalAlignment="Left" />
                    </ScrollViewer>
                </DockPanel>

                <!-- Paleta de comandos superpuesta -->
                <Border Background="#99000000"
                        Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="660" MaxHeight="480" VerticalAlignment="Top" Margin="0,90,0,0"
                            Background="#FF2C2C2C" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <DockPanel>
                            <TextBox DockPanel.Dock="Top"
                                     Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="15" Padding="12,8" Margin="0,0,0,12"
                                     x:Name="PaletteInput" />
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource CaptionText}"
                                       Margin="4,10,0,0"
                                       Text="Mismos nombres que av-light-tools. Esc para cerrar." />
                            <ListBox ItemsSource="{Binding Palette.Results}"
                                     SelectedItem="{Binding Palette.Selected, Mode=TwoWay}"
                                     HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding ModuleId}"
                                                       Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
